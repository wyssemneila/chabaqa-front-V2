# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SERVER_URL=http://localhost:3000/api
FRONTEND_URL=http://localhost:8083
NEXT_PUBLIC_APP_URL=http://localhost:8083

# Kill switch for plan/paywall enforcement while iterating locally.
FREE_MODE=true
PLAN_ENFORCEMENT_MODE=false

# --- Database ---------------------------------------------------------------
# Local dev: single-node replica set started by docker-compose (mongo + mongo-init).
MONGO_URI=mongodb://127.0.0.1:27017/chabaqa_local?replicaSet=rs0
MONGODB_URI=mongodb://127.0.0.1:27017/chabaqa_local?replicaSet=rs0
DB_NAME=chabaqa_local

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-64-hex-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-64-hex-chars
JWT_REFRESH_EXPIRES_IN=30d
EVENT_QR_JWT_SECRET=replace-with-64-hex-chars
EVENT_QR_JWT_TTL=30d
# Internal backend-to-backend writes, e.g. subscription usage metering.
INTERNAL_SERVICE_TOKEN=replace-with-64-hex-chars

# --- Email (SMTP) -------------------------------------------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=Chabaqa
EMAIL_REPLY_TO=noreply@example.com
EMAIL_LOGO_URL=

# --- OAuth ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback

# --- Creator integrations ------------------------------------------------------
# Dedicated AES-256-GCM key for long-lived third-party credentials. Generate
# with: openssl rand -base64 32. Never reuse JWT_SECRET or commit this value.
INTEGRATIONS_ENCRYPTION_KEY=
# Public callback base used by Google Sheets, Zoom, and Discord. Register each
# exact provider callback URL, for example:
# https://chabaqa.io/api/creator/integrations/oauth/google_sheets/callback
INTEGRATIONS_OAUTH_CALLBACK_BASE_URL=http://localhost:8080/api/creator/integrations/oauth

# Google Sheets OAuth (enable Google Sheets API and register redirect URI).
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_SHEETS_REDIRECT_URI=

# Zoom Marketplace user-level OAuth (not Server-to-Server OAuth).
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=

# Discord creator OAuth. Bot token remains server-only; never expose it in the
# creator UI or a client bundle. Install the bot in each selected guild.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=

# --- Payments ------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
# Stable recurring Stripe Prices for creator plans. Required in production.
STRIPE_PRICE_STARTER_MONTH=price_replace_starter_month
STRIPE_PRICE_STARTER_YEAR=price_replace_starter_year
STRIPE_PRICE_GROWTH_MONTH=price_replace_growth_month
STRIPE_PRICE_GROWTH_YEAR=price_replace_growth_year
STRIPE_PRICE_PRO_MONTH=price_replace_pro_month
STRIPE_PRICE_PRO_YEAR=price_replace_pro_year
PAYMENTS_REQUIRE_PAID_ORDER=true
PAYMENTS_STRIPE_DEFAULT=true
PAYMENTS_ENABLE_WALLET_FALLBACK=true
PAYMENTS_STRIPE_COMMUNITY_ENABLED=true
PAYMENTS_STRIPE_COURSE_ENABLED=true
PAYMENTS_STRIPE_CHAPTER_ENABLED=true
PAYMENTS_STRIPE_CHALLENGE_ENABLED=true
PAYMENTS_STRIPE_EVENT_ENABLED=true
PAYMENTS_STRIPE_PRODUCT_ENABLED=true
PAYMENTS_STRIPE_SESSION_ENABLED=true
PAYMENTS_REDIRECT_ALLOWLIST=chabaqa://,exp://,http://localhost:8080,https://chabaqa.io

# --- Web Push ------------------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_SUBJECT=mailto:notifications@example.com
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

MAX_FILE_SIZE=104857600
UPLOAD_PATH=./uploads

CORS_ORIGIN=http://localhost:8083
CORS_ALLOWED_ORIGINS=http://localhost:8083
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Redis (required if REDIS_ENABLED=true; see docker-compose.yml) ------------
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-password
REDIS_DB=0
REDIS_TTL=300
# Used by Socket.IO adapter for multi-instance realtime (optional locally).
REDIS_URL=redis://:replace-with-strong-password@127.0.0.1:6379/0
SOCKET_IO_REDIS_URL=redis://:replace-with-strong-password@127.0.0.1:6379/0

UV_THREADPOOL_SIZE=128

# --- AI (optional) ---------------------------------------------------------------
OPENROUTER_API_KEY=
AI_PROVIDER=OLLAMA_CLOUD
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
AI_MODEL=gpt-oss:20b-cloud
# Embeddings for RAG (free-first). Defaults to the OpenRouter/OLLAMA API key if unset.
# OpenRouter free default: free/text-embedding-3-small ; Ollama: nomic-embed-text
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_MAX_INPUT_CHARS=4000
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_MS=30000
# Augment AI tutor context with related community knowledge (needs embeddings).
AI_TUTOR_ENRICHMENT=true
# Use chapter video transcripts as tutor context sources (needs TranscriptionService).
AI_TUTOR_TRANSCRIPT=true
# Transcription (optional, free-first). Set to a Whisper-compatible API.
# OpenAI: whisper-1 ; Groq: whisper-large-v3 ; self-host: any Whisper API.
TRANSCRIPTION_API_KEY=
TRANSCRIPTION_BASE_URL=
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_MAX_AUDIO_BYTES=26214400
TRANSCRIPTION_TIMEOUT_MS=120000

# --- WhatsApp AI (optional, free-first) ----------------------------------------
# Auto-reply to inbound WhatsApp messages + broadcast draft generation.
# Set WHATSAPP_AI_AUTOREPLY=true to enable automatic replies on inbound messages.
# Uses the same OPENROUTER_API_KEY / OLLAMA_API_KEY as the rest of the AI platform.
WHATSAPP_AI_AUTOREPLY=false
WHATSAPP_AI_MODEL=
WHATSAPP_AI_FALLBACK_MODELS=
WHATSAPP_AI_TEMPERATURE=0.4
WHATSAPP_AI_MAX_TOKENS=500
WHATSAPP_AI_TIMEOUT_MS=30000

# --- Analytics (optional) ---------------------------------------------------------
GA4_MEASUREMENT_ID=
GA4_API_SECRET=
GA4_PROPERTY_ID=

MEDIA_PUBLIC_BASE_URL=http://localhost:3000
TRUST_PROXY=1
JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb
ENABLE_SWAGGER=true
# Generate with: openssl rand -hex 32
ADMIN_BOOTSTRAP_KEY=replace-with-64-hex-chars
ADMIN_ALLOW_PASSWORD_ONLY_LOGIN=true
ALLOW_ADMIN_DB_CLEANUP=false
ALLOW_REMOTE_WIPE=false

AFFILIATE_COOKIE_NAME=chabaqa_aff_click
AFFILIATE_IP_HASH_SALT=replace-with-random-string
AFFILIATE_DEFAULT_COOKIE_DAYS=30
AFFILIATE_DEFAULT_HOLD_DAYS=14
AFFILIATE_MIN_PAYOUT_DT=50

# --- Object storage (S3-compatible / MinIO) ---------------------------------------
MEDIA_STORAGE_DRIVER=s3
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=chabaqa-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# --- Malware scanning (ClamAV) ---------------------------------------------------
UPLOAD_MALWARE_SCANNING=optional
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# --- Observability (optional) -----------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=chabaqa-backend
# Sentry (EU): https://sentry.io — create project → Client Keys (DSN)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Search (Meilisearch) -------------------------------------------------------
MEILI_HOST=http://127.0.0.1:7700
MEILI_API_KEY=
MEILI_GLOBAL_INDEX=chabaqa_content

# --- WhatsApp campaigns / native OpenWA gateway --------------------------------
# The OpenWA gateway is a separate localhost-only systemd service. See
# docs/OPENWA_NATIVE.md. Do not expose its port or put this API key in frontend code.
WHATSAPP_ENABLED=false
OPENWA_BASE_URL=http://127.0.0.1:2785/api
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=
OPENWA_WEBHOOK_URL=https://chabaqa.io/api/whatsapp/openwa/webhook
WHATSAPP_DAILY_SESSION_SEND_LIMIT=200
WHATSAPP_SEND_INTERVAL_MS=1500
WHATSAPP_APPEND_OPT_OUT_FOOTER=true

# --- Performance ----------------------------------------------------------------
# Log Mongo queries slower than this threshold (ms). Set 0 to disable.
MONGO_SLOW_QUERY_MS=100
