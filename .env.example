# Root-level variables consumed by docker-compose.yml (${VAR} substitution).
# Copy to .env at the repo root for local `docker compose` runs.
# Must stay in sync with backend/.env for REDIS_PASSWORD and MinIO credentials.

REDIS_PASSWORD=replace-with-strong-password

MINIO_ROOT_USER=replace-with-access-key-id
MINIO_ROOT_PASSWORD=replace-with-strong-password
MINIO_BROWSER_REDIRECT_URL=https://chabaqa.io/monitoring/storage/
S3_BUCKET=chabaqa-media
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-strong-password
GRAFANA_ROOT_URL=https://chabaqa.io/monitoring/grafana/

# Sentry — also set in backend/.env and frontend/.env (docker compose reads root .env)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# PagerDuty Events API v2 (EU) — critical Alertmanager alerts
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_EVENTS_URL=https://events.eu.pagerduty.com/v2/enqueue
ALERTMANAGER_EXTERNAL_URL=https://chabaqa.io/monitoring/alertmanager/

WHATSAPP_ENABLED=false
OPENWA_API_KEY=
OPENWA_WEBHOOK_SECRET=
OPENWA_WEBHOOK_URL=http://chabaqa-backend:3000/api/whatsapp/openwa/webhook
WHATSAPP_DAILY_SESSION_SEND_LIMIT=200
WHATSAPP_SEND_INTERVAL_MS=1500
WHATSAPP_APPEND_OPT_OUT_FOOTER=true

# Meilisearch (global content search)
MEILI_MASTER_KEY=replace-with-strong-master-key
MEILI_GLOBAL_INDEX=chabaqa_content
