# Native OpenWA gateway. Keep this file only at /etc/chabaqa/openwa.env.
NODE_ENV=production
PORT=2785
BIND_HOST=127.0.0.1
DOMAIN=chabaqa.io
CORS_ORIGINS=https://chabaqa.io
API_MASTER_KEY=replace-with-a-long-random-value
API_KEY_PEPPER=replace-with-a-long-random-value

# OpenWA stores its SQLite database, sessions, and generated API key here.
DATABASE_TYPE=sqlite
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/opt/openwa/data/media
SESSION_DATA_PATH=/opt/openwa/data/sessions
BAILEYS_AUTH_DIR=/opt/openwa/data/baileys
PLUGINS_DIR=/opt/openwa/data/plugins
AUTO_START_SESSIONS=true
MAX_CONCURRENT_SESSIONS=4

# Baileys avoids Chromium and fits a small VPS. It has a higher account-risk
# profile than whatsapp-web.js, so use only dedicated, opted-in sender numbers.
ENGINE_TYPE=baileys
BAILEYS_MARK_ONLINE_ON_CONNECT=false
SEND_PACING_ENABLED=true
SEND_PACING_WARMUP_SCHEDULE=20,40,80,160,320
SEND_PACING_COLD_DAILY_CAP=5,10,20,40,60
SEND_PACING_BREAKER_THRESHOLD=5
SEND_PACING_BREAKER_COOLDOWN_MS=900000

WEBHOOK_SSRF_PROTECT=true
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_DELAY=5000
AUDIT_RETENTION_DAYS=90
