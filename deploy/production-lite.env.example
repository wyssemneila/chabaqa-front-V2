# Dokploy encrypted environment values. Do not commit the real file.
BACKEND_IMAGE=ghcr.io/owner/chabaqa-backend:COMMIT_SHA
FRONTEND_IMAGE=ghcr.io/owner/chabaqa-frontend:COMMIT_SHA
REDIS_PASSWORD=generate-a-long-random-value

# backend.production.env is a separate Dokploy secret file. Required values:
# NODE_ENV=production
# PORT=3000
# MONGO_URI=mongodb+srv://...              # Atlas/managed replica-set URI
# MONGODB_URI=mongodb+srv://...
# REDIS_ENABLED=true
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=<same as above>
# REDIS_URL=redis://:<password>@redis:6379/0
# SOCKET_IO_REDIS_URL=redis://:<password>@redis:6379/0
# UV_THREADPOOL_SIZE=8
# NODE_OPTIONS=--max-old-space-size=768 --max-semi-space-size=32
# MEDIA_STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<your S3-compatible endpoint>
# S3_FORCE_PATH_STYLE=false                # true only for path-style providers
# S3_REGION=auto
# S3_BUCKET=chabaqa-media
# S3_ACCESS_KEY=<key>
# S3_SECRET_KEY=<secret>
# UPLOAD_MALWARE_SCANNING=disabled          # or best_effort with an external scanner
# Do not set MEILI_HOST unless a managed Meilisearch service is provisioned.

# frontend.production.env:
# NODE_ENV=production
# NEXT_PUBLIC_API_URL=https://your-domain/api
# NEXT_PUBLIC_APP_URL=https://your-domain
