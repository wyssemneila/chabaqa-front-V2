{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node --max-old-space-size=1536 --max-semi-space-size=8 ./node_modules/next/dist/bin/next build",
    "dev": "next dev -p 8083",
    "lint": "next lint",
    "start": "next start -p 8083",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:e2e:report": "playwright show-report",
    "guard:no-relative-api": "node scripts/check-no-relative-api.js",
    "check:browser-compat": "node scripts/check-browser-compatibility.js",
    "i18n:translate:ar": "node scripts/i18n/translate-libre.mjs",
    "i18n:check:parity": "node scripts/i18n/check-parity.mjs",
    "i18n:check:hardcoded": "node scripts/i18n/find-hardcoded.mjs",
    "i18n:ci": "npm run i18n:check:parity && node scripts/i18n/find-hardcoded.mjs \"app/(auth)\" \"app/(landing)\" \"app/(admin)\"",
    "postbuild": "node scripts/sync-standalone-assets.js"
  },
